# Python / test caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
pytest-cache-files-*/

# Local environments and secrets
.venv/
.claude/
.env
.env.*

# Generated experiment outputs
.scratch/
runs/
temporal_graph_*.html

# Parallel datasets: track control metadata, keep payloads local.
/datasets/**/payload/
# Sealed heavy assets stay local; manifests, source snapshots and hashes are tracked.
/archive/**/assets/
/archive/**/original_mainline/
/archive/**/runtime_superseded/
/archive/**/third_party/
/archive/**/environment_state/
# Paper/release snapshots contain local compiler caches and generated bundles.
# Previously tracked sources are added explicitly at their sealed locations.
/archive/legacy_20260928/shared/papers_and_release/
!/datasets/*/runs/
/datasets/*/runs/**
!/datasets/*/runs/**/
!/datasets/*/runs/**/asset_pointer.json
!/datasets/*/runs/**/metadata/*.json

# Local caches and work directories
data/cache/
data/workdir/
/data/examples/*/frames/

# Local dataset assets (source annotations, frames, and HSGG archives)
/data/next-qa/
/data/openeqa/
/HSGG_upload.tgz

